<?xml version="1.0" encoding="utf-8"?>
<!-- Data never leaves the device via Google cloud backup; users back up manually with JSON export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" />
        <include domain="file" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
